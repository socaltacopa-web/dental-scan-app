{
  "name": "dental-scan-railway",
  "version": "0.1.3",
  "entrypoint": "app.main:app",
  "healthcheck": "/health",
  "storage": "RAILWAY_VOLUME_MOUNT_PATH or DATA_DIR",
  "prototype_only": true,
  "features": [
